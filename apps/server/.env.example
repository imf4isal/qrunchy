# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/qrunchy

# Frontend URL for CORS and QR code generation
FRONTEND_URL=http://localhost:5173

# Cloudflare R2 Configuration for file uploads
R2_BUCKET_NAME=your-bucket-name
R2_ENDPOINT=https://your-endpoint.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://your-public-url.r2.dev
R2_ACCESS_KEY_ID=your-access-key-id
R2_SECRET_ACCESS_KEY=your-secret-access-key

# SMS Orbis Configuration for OTP
SMS_ORBIS_API_KEY=your-sms-orbis-api-key
SMS_ORBIS_SENDER_ID=your-sender-id

# Server Configuration
PORT=3001