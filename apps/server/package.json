{
  "name": "server",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "start:docker": "npm run migrate:prod && npm run start",
    "dev": "npx tsx src/index.mts",
    "dev:docker": "npm run migrate && npm run dev",
    "dev:watch": "nodemon --watch src --ext ts,mts --exec \"npx tsx src/index.mts\"",
    "build": "tsc -p tsconfig.build.json",
    "migrate": "npx tsx src/db/migrate.mts",
    "migrate:prod": "node dist/db/migrate.js",
    "migrate:down": "npx tsx src/db/migrate.mts down"
  },
  "keywords": [],
  "author": "Faisal",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.844.0",
    "@aws-sdk/lib-storage": "^3.844.0",
    "@trpc/server": "^11.1.2",
    "@types/bcrypt": "^6.0.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "helmet": "^8.1.0",
    "kysely": "^0.28.2",
    "mime-types": "^2.1.35",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.16.0",
    "superjson": "^2.2.2",
    "trpc-playground": "^1.0.4",
    "uuid": "^11.1.0",
    "zod": "^3.25.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.18",
    "@types/express": "^5.0.2",
    "@types/mime-types": "^2.1.4",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.17.47",
    "@types/pg": "^8.15.2",
    "@types/uuid": "^10.0.0",
    "kysely-codegen": "^0.18.5",
    "nodemon": "^3.1.10",
    "ts-node": "^10.9.2",
    "tsx": "^4.7.1",
    "typescript": "^5.4.3",
    "wrangler": "^4.24.3"
  }
}
